__pycache__/
*.py[cod]
build/
dist/
*.egg-info/
.pytest_cache/

# Evidence from a probe run: a measurement of a moment, regenerated by the run
# that needs it. Committed, it is stale on arrival and reads as current.
battery/pin_evidence.json

# Capture series are generated by battery/make_series.py and measure the ENGINE.
# A committed one would be evidence about a fixture, presented as evidence about
# an organisation.
battery/series/

# Per-clone and NEVER committed: it names internal identifiers, and it is the
# file that gives this clone a rule against the internal commit format. It does
# not travel -- a fresh clone has no rule until somebody copies it in.
.hygiene-local.json
